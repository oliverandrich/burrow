// Package __AppName__ is a contrib-style app generated by `burrow generate app`.
package __AppName__

import (
	"embed"
	"io/fs"
	"net/http"

	"github.com/go-chi/chi/v5"
	"github.com/oliverandrich/burrow"
)

//go:embed templates
var templateFS embed.FS

// App is the __AppName__ app.
type App struct{}

// New creates a new __AppName__ app.
func New() *App { return &App{} }

// Name returns the app's stable identifier.
func (a *App) Name() string { return "__AppName__" }

// TemplateFS exposes the app's HTML templates to the server.
func (a *App) TemplateFS() fs.FS {
	sub, _ := fs.Sub(templateFS, "templates")
	return sub
}

// Routes registers the app's HTTP routes.
func (a *App) Routes(r chi.Router) {
	r.Get("/__AppName__", burrow.Handle(a.index))
}

func (a *App) index(w http.ResponseWriter, r *http.Request) error {
	return burrow.Render(w, r, http.StatusOK, "__AppName__/index", map[string]any{
		"Title": "__AppName__",
	})
}
