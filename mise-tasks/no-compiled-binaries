#!/usr/bin/env bash
#MISE description="Reject staged compiled binaries (Mach-O / ELF / PE)"
set -euo pipefail

violations=()

# Note: on macOS, `file --brief --mime-type` on a universal (multi-arch) binary
# emits one mime-type line per architecture, so the value is multi-line. Use a
# regex match on the joined output instead of an exact case on a single line.
binary_mime_re='application/(x-mach-binary|x-executable|x-pie-executable|vnd\.microsoft\.portable-executable)'

for f in "$@"; do
    [ -f "$f" ] || continue
    mime=$(file --brief --mime-type -- "$f")
    if grep -qE "$binary_mime_re" <<<"$mime"; then
        violations+=("$f")
    fi
done

if [ ${#violations[@]} -gt 0 ]; then
    echo "Refusing to commit compiled binaries:" >&2
    printf '  %s\n' "${violations[@]}" >&2
    echo >&2
    echo "Build outputs belong outside the repo. Use 'go build -o bin/...' or add the file to .gitignore." >&2
    exit 1
fi
